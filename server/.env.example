# Salin menjadi .env lalu isi
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/presensia
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES=24h

# Konfigurasi kantor awal (dapat diubah lewat PUT /api/office oleh admin)
OFFICE_LAT=-6.175392
OFFICE_LNG=106.827153
OFFICE_RADIUS_M=150

# Produksi: ganti penyimpanan foto base64 dengan bucket S3
# AWS_S3_BUCKET=presensia-photos
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
